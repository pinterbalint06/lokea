{
    "name": "lokea",
    "version": "1.0.0",
    "description": "Lokea backend - Express alapú REST API a játék szerveroldali logikájához: játékmenedzsment, játéktérképek létrehozása és kezelése, felhasználói regisztráció és jogosultságkezelés, képfeltöltések és adatbázis-műveletek. Tartalmaz fejlesztési és tesztelési parancsokat is.",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "test": "cross-env NODE_ENV=test jest --testTimeout=10000",
        "test:watch": "jest --watchAll",
        "start": "node server.js",
        "dev": "nodemon"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pinterbalint06/lokea.git"
    },
    "homepage": "https://github.com/pinterbalint06/lokea#readme",
    "keywords": [
        "lokea",
        "game"
    ],
    "imports": {
        "#utils/*": "./utils/*",
        "#sql/*": "./sql/*",
        "#config/*": "./config/*",
        "#mapcreatortest/*": "./test/mapcreator/*",
        "#gametest/*": "./test/game/*",
        "#root/*": "./*",
        "#admin/*": "./api/admin/*",
        "#mapcreator/*": "./api/mapcreator/*",
        "#gamemaps/*": "./api/gamemaps/*",
        "#gameflow/*": "./api/gameflow/*",
        "#testhelpers/*": "./test/helpers/*",
        "#locales/*": "./locales/*",
        "#imagequeries": "./api/shared/queries/shared-images.queries.js",
        "#sharedapi/*": "./api/shared/*"
    },
    "author": "Lokea csapata",
    "contributors": [
        "Eördögh Erik",
        "Pintér Bálint",
        "Varga Norbert"
    ],
    "license": "ISC",
    "devDependencies": {
        "cross-env": "^10.1.0",
        "jest": "^30.3.0",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "chart.js": "^4.5.1",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "express-validator": "^7.3.1",
        "i18next": "^26.0.6",
        "i18next-fs-backend": "^2.6.4",
        "i18next-http-middleware": "^3.9.3",
        "joi": "^18.1.2",
        "multer": "^2.0.2",
        "mysql2": "^3.16.1",
        "nodemailer": "^8.0.4",
        "sharp": "^0.34.5",
        "skia-canvas": "^3.0.8",
        "socket.io": "^4.8.3",
        "supertest": "^7.2.2",
        "validator": "^13.15.26"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}