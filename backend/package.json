{
    "name": "nodejs-template-2025",
    "version": "1.0.0",
    "description": "Template project",
    "main": "server.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watchAll",
        "start": "node server.js",
        "dev": "nodemon"
    },
    "author": "Kardos Krisztián",
    "license": "ISC",
    "devDependencies": {
        "nodemon": "^3.1.10"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "chart.js": "^4.5.1",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-session": "^1.18.2",
        "express-validator": "^7.3.1",
        "http": "^0.0.1-security",
        "i18next": "^26.0.6",
        "i18next-fs-backend": "^2.6.4",
        "i18next-http-middleware": "^3.9.3",
        "jest": "^30.3.0",
        "multer": "^2.0.2",
        "mysql2": "^3.16.1",
        "nodemailer": "^8.0.4",
        "sharp": "^0.34.5",
        "skia-canvas": "^3.0.8",
        "socket.io": "^4.8.3",
        "supertest": "^7.2.2",
        "validator": "^13.15.26"
    },
    "jest": {
        "rootDir": "../",
        "roots": [
            "<rootDir>/backend",
            "<rootDir>/private/backend"
        ],
        "collectCoverageFrom": [
            "<rootDir>/backend/**/*.js",
            "<rootDir>/private/backend/**/*.js",
            "!**/node_modules/**"
        ],
        "coverageDirectory": "<rootDir>/backend/coverage",
        "moduleNameMapper": {
            "^#sql/(.*)$": "<rootDir>/private/backend/sql/$1",
            "^#utils/(.*)$": "<rootDir>/include/utils/$1",
            "^#root/(.*)$": "<rootDir>/$1"
        }
    }
}